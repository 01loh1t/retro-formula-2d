# Copy this file to ".env" and fill in the values.
# The .env file is listed in .gitignore, so it never gets committed to GitHub.

# Connection string for your PostgreSQL database.
# Neon, Supabase, Render and Railway all give you one of these when you create a database.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Secret used to sign login cookies. Must be at least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If this ever changes, everyone gets logged out - which is exactly what you want if it leaks.
JWT_SECRET=replace_me_with_a_long_random_string

# Port the server listens on. Hosting platforms set this for you.
PORT=3000

# Set to "production" when deployed. This turns on HTTPS-only login cookies.
NODE_ENV=development
